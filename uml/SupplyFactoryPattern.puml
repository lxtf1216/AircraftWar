@startuml SupplyFactoryPattern

!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle bold

title 道具生产工厂模式

interface SupplyFactory {
    + Supply createNewSupply(int LocationX, int LocationY, int SpeedX, int SpeedY)
}

class HpSupplyFactory {
