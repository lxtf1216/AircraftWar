}

class BombSupplyFactory {
    + Supply createNewSupply(int LocationX, int LocationY, int SpeedX, int SpeedY)
}

class BulletPlusSupplyFactory {
    + Supply createNewSupply(int LocationX, int LocationY, int SpeedX, int SpeedY)
}

interface Supply {
}

class HpSupply {
}

class BulletSupply {
}

class BombSupply {
}

class BulletPlusSupply {
}

SupplyFactory <|.. HpSupplyFactory
SupplyFactory <|.. BulletSupplyFactory
SupplyFactory <|.. BombSupplyFactory
SupplyFactory <|.. BulletPlusSupplyFactory

Supply <|.. HpSupply
Supply <|.. BulletSupply
Supply <|.. BombSupply
