@startuml AircraftFactoryPattern

!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle bold

title 敌机生产工厂模式

interface AircraftFactory {
    + EnemyAircraft createNewEnemyAircraft()
}

class MobEnemyFactory {
    + EnemyAircraft createNewEnemyAircraft()
}

class EliteEnemyFactory {
    + EnemyAircraft createNewEnemyAircraft()
}

interface EnemyAircraft {
}

class MobEnemy {
}

class EliteEnemy {
}

AircraftFactory <|.. MobEnemyFactory
AircraftFactory <|.. EliteEnemyFactory

EnemyAircraft <|.. MobEnemy
EnemyAircraft <|.. EliteEnemy

MobEnemyFactory ..> MobEnemy : creates
EliteEnemyFactory ..> EliteEnemy : creates

note top of AircraftFactory : 工厂模式核心要素:\n- 抽象工厂接口\n- 具体工厂实现\n- 产品接口\n- 具体产品实现\n- 客户端与具体产品解耦

@enduml
